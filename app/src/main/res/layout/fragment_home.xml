<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_overlay" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="90dp"
            android:paddingEnd="30dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/home_news_badge"
                        android:fontFamily="@font/montserrat_bold"
                        android:letterSpacing="0"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="NEWS RP"
                        android:textAllCaps="true"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:fontFamily="@font/montserrat_black"
                        android:lineSpacingExtra="1dp"
                        android:maxWidth="520dp"
                        android:text="لێرەوە دەست پێ بکە"
                        android:textColor="@android:color/white"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:maxWidth="620dp"
                        android:text="سێرڤەری چالاک و هەنگاوە سەرەکییەکان لە یەک شاشەی سادەدا."
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:background="@drawable/launcher_field_surface_dark"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/home_readiness_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/home_news_badge" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/home_readiness_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="لانچەر ئامادەیە"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/home_readiness_body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/montserrat_medium"
                            android:text="پشکنینی هەنگاوی دواتر"
                            android:textColor="@color/launcher_text_muted"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="252dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1.08"
                    android:background="@drawable/launcher_hero_panel"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="سێرڤەری هەڵبژێردراو"
                            android:textColor="@color/launcher_text_secondary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/launcher_badge_outline"
                            android:fontFamily="@font/montserrat_bold"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="یاری"
                            android:textColor="@color/launcher_text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/selected_server_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/montserrat_black"
                        android:maxLines="1"
                        android:text="هیچ سێرڤەرێکی چالاک نییە"
                        android:textColor="@android:color/white"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/selected_server_address"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="9dp"
                        android:background="@drawable/launcher_field_surface_dark"
                        android:fontFamily="@font/montserrat_medium"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="IPـیەک لە بەشی سێرڤەرەکان زیاد بکە"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/selected_server_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="2"
                        android:text="لیستەکە لە ئەپەکەدا پاشەکەوت دەکرێت و سێرڤەری چالاک دەچێتە فایلی یارییەکە."
                        android:textColor="@color/launcher_text_muted"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/play_button"
                            android:layout_width="190dp"
                            android:layout_height="48dp"
                            android:background="@drawable/home_play_button"
                            android:fontFamily="@font/montserrat_black"
                            android:letterSpacing="0"
                            android:text="یاری بکە"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/select_server_button"
                            android:layout_width="190dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/home_server_select_button"
                            android:fontFamily="@font/montserrat_bold"
                            android:letterSpacing="0"
                            android:text="گۆڕینی سێرڤەر"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="252dp"
                    android:layout_weight="0.92"
                    android:background="@drawable/home_panel_surface"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_black"
                        android:text="هەنگاوی دواتر"
                        android:textColor="@android:color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="2"
                        android:text="بزانە چی ماوە پێش ئەوەی بچیتە ناو یارییەکە."
                        android:textColor="@color/launcher_text_muted"
                        android:textSize="10sp" />




                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/home_next_step_button"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:background="@drawable/home_server_select_button"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center"
                        android:text="هەنگاوی دواتر"
                        android:textColor="@android:color/white"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
