<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_overlay" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="20dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/home_panel_surface"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="ڕێکخستنەکان"
                    android:textColor="@android:color/white"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/home_server_card_surface"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="ناوی یاریزان"
                        android:textColor="@android:color/white"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/player_name_value"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/launcher_field_surface_dark"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="هیچ ناوێک دیاری نەکراوە"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="12sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="ئەم ناوە دەچێتە فایلی یارییەکە."
                        android:textColor="@color/launcher_text_muted"
                        android:textSize="10.5sp" />
                    <TextView
                        android:id="@+id/button_edit_profile"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/home_server_select_button"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center"
                        android:minWidth="150dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="گۆڕینی ناو"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/home_server_card_surface"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="سنووری FPS"
                            android:textColor="@android:color/white"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/settings_fps_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="60 FPS"
                            android:textColor="@color/launcher_accent_gold_bright"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/settings_fps_seek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:max="90"
                        android:progress="30"
                        android:progressTint="@color/launcher_accent_gold_bright"
                        android:thumbTint="@color/launcher_accent_gold_bright" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="بۆ مۆبایلی لاواز ٣٠ یان ٤٥ هەڵبژێرە. ئەم گۆڕانکارییە لە جاری داهاتووی یاری جێبەجێ دەبێت."
                        android:textColor="@color/launcher_text_muted"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/home_server_card_surface"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="قەبارەی چات"
                        android:textColor="@android:color/white"
                        android:textSize="13sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/chat_size_small"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/launcher_field_surface_dark"
                            android:fontFamily="@font/montserrat_bold"
                            android:gravity="center"
                            android:text="بچووک"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/chat_size_medium"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/launcher_field_surface_dark"
                            android:fontFamily="@font/montserrat_bold"
                            android:gravity="center"
                            android:text="ناوەند"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/chat_size_large"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/launcher_field_surface_dark"
                            android:fontFamily="@font/montserrat_bold"
                            android:gravity="center"
                            android:text="گەورە"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="ژمارەی ئەو نامانەی لە چاتدا پێکەوە دەردەکەون: بچووک ٥، ناوەند ١٠، گەورە ٢٠."
                        android:textColor="@color/launcher_text_muted"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/home_server_card_surface"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="کیبۆردی سیستەم"
                            android:textColor="@android:color/white"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/keyboard_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="چالاک: کیبۆردی ئەندرۆید بەکاردێت. ناچالاک: کیبۆردی تایبەتی یاری بەکاردێت."
                        android:textColor="@color/launcher_text_muted"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/home_server_card_surface"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="داتای یاری"
                        android:textColor="@android:color/white"
                        android:textSize="13sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="داتای یاری بپشکنە و نوێ بکەرەوە. فایلەکانی ئێستات بە یەکجاری ناسڕدرێنەوە."
                        android:textColor="@color/launcher_text_muted"
                        android:textSize="10.5sp" />
                    <TextView
                        android:id="@+id/button_update_data"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/home_server_select_button"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center"
                        android:minWidth="150dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="نوێکردنەوەی داتا"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</FrameLayout>
